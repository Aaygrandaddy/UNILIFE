# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These values identify your project; they are not secret. Access is controlled by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Set to 1 only for local testing against the Firebase emulators.
VITE_FIREBASE_EMULATOR=
